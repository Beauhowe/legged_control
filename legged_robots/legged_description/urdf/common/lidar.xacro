<?xml version="1.0"?>
<robot name="lidar" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="lidar_red">
        <color rgba="1 0 0 1"/>
    </material>

    <!--
      Gazebo Classic GPU LiDAR for ROS2.
      Default topic matches elevation_mapping_ros2/config/robots/fastlio_mid360_robot.yaml.
    -->
    <xacro:macro name="lidar" params="
                  parent_link:=base
                  name_prefix:=lidar
                  link_name:=lidar_link
                  x:=0.20
                  y:=0.0
                  z:=0.08
                  roll:=0.0
                  pitch:=0.0
                  yaw:=0.0
                  h_samples:=96
                  v_samples:=72
                  h_fov_deg:=120.0
                  v_fov_deg:=90.0
                  min_range:=0.10
                  max_range:=75.0
                  update_rate:=10.0
                  topic:=/cloud_lidar2_filtered
                  visualize:=true">

        <xacro:property name="lidar_pi" value="3.1415926535897931"/>
        <xacro:property name="h_half_rad" value="${h_fov_deg * lidar_pi / 360.0}"/>
        <xacro:property name="v_half_rad" value="${v_fov_deg * lidar_pi / 360.0}"/>
        <xacro:property name="lidar_link" value="${link_name}"/>

        <link name="${lidar_link}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.03 0.02 0.04"/>
                </geometry>
                <material name="lidar_red"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.03 0.02 0.04"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.05"/>
                <inertia ixx="1e-5" ixy="0" ixz="0"
                         iyy="1e-5" iyz="0"
                         izz="1e-5"/>
            </inertial>
        </link>

        <joint name="${name_prefix}_lidar_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="${lidar_link}"/>
            <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
        </joint>

        <gazebo reference="${lidar_link}">
            <material>Gazebo/Red</material>
            <sensor name="${name_prefix}_gpu_lidar" type="ray">
                <pose>0 0 0 0 0 0</pose>
                <update_rate>${update_rate}</update_rate>
                <always_on>true</always_on>
                <visualize>${visualize}</visualize>

                <ray>
                    <scan>
                        <horizontal>
                            <samples>${h_samples}</samples>
                            <resolution>1</resolution>
                            <min_angle>${-h_half_rad}</min_angle>
                            <max_angle>${h_half_rad}</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>${v_samples}</samples>
                            <resolution>1</resolution>
                            <min_angle>${-v_half_rad}</min_angle>
                            <max_angle>${v_half_rad}</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>${min_range}</min>
                        <max>${max_range}</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>

                <plugin name="${name_prefix}_gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <remapping>~/out:=${topic}</remapping>
                    </ros>
                    <output_type>sensor_msgs/PointCloud2</output_type>
                    <frame_name>${lidar_link}</frame_name>
                </plugin>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
