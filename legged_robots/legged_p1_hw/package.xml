<?xml version="1.0"?>
<package format="3">
  <name>legged_p1_hw</name>
  <version>0.0.0</version>
  <description>P1 ROS2 control hardware interface over Fast DDS.</description>
  <maintainer email="liaoqiayuan@gmail.com">Qiayuan Liao</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen3_cmake_module</depend>

  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>legged_hw</depend>
  <depend>ocs2_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
