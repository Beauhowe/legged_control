      <geometry>
        <mesh
          filename="../meshs_simpilfy/RR_foot.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="RH_foot_fixed"
    type="fixed"
    dont_collapse="true">
    <origin
      xyz="0 0 -0.35"
      rpy="0 0 0" />
    <parent
      link="RH_calf" />
    <child
      link="RH_FOOT" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- Unitree-style IMU link expected by legged_controller. -->
  <joint name="base_imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base" />
    <child link="base_imu" />
  </joint>
  <link name="base_imu">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.004" />
      </geometry>
    </visual>
  </link>

  <!-- ros2_control interfaces matched to legged_control's Unitree-style controller. -->
  <ros2_control name="legged_unitree_hw" type="system">
    <hardware>
      <plugin>legged_gazebo/LeggedHWSim</plugin>
      <param name="robot_type">lr_pro</param>
      <param name="power_limit">4</param>
      <param name="contact_threshold">40</param>
      <param name="delay">0.009</param>
    </hardware>

    <joint name="LF_HAA">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="LF_HFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="LF_KFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="LH_HAA">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="LH_HFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="LH_KFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="RF_HAA">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="RF_HFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="RF_KFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="RH_HAA">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="RH_HFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="RH_KFE">
      <command_interface name="position_desired" />
      <command_interface name="velocity_desired" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="feedforward" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <sensor name="LF_FOOT">
      <state_interface name="contact" />
    </sensor>
    <sensor name="RF_FOOT">
      <state_interface name="contact" />
    </sensor>
    <sensor name="LH_FOOT">
      <state_interface name="contact" />
    </sensor>
    <sensor name="RH_FOOT">
      <state_interface name="contact" />
    </sensor>

    <sensor name="base_imu">
      <state_interface name="orientation.x" />
      <state_interface name="orientation.y" />
      <state_interface name="orientation.z" />
      <state_interface name="orientation.w" />
      <state_interface name="angular_velocity.x" />
      <state_interface name="angular_velocity.y" />
      <state_interface name="angular_velocity.z" />
      <state_interface name="linear_acceleration.x" />
      <state_interface name="linear_acceleration.y" />
      <state_interface name="linear_acceleration.z" />
    </sensor>
  </ros2_control>

</robot>