<library path="lr_pro_hw">
  <!--
    pluginlib 插件导出文件。
    robot.xacro 中 <plugin>lr_pro_hw/LrProHW</plugin> 会通过这个名字加载 legged::LrProHW。
  -->
  <class name="lr_pro_hw/LrProHW"
         type="legged::LrProHW"
         base_class_type="hardware_interface::SystemInterface">
    <description>lr_pro 的 ROS2 硬件接口骨架，后续需要在 read()/write() 中接入真实通信。</description>
  </class>
</library>
