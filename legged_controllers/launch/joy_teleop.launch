<?xml version="1.0" ?>

<launch>
    <!-- 手柄 Joy 话题默认 /legged_robot/joystick（与旧版 /joy 区分）；改回旧名：joy_topic:=/joy -->
    <arg name="joy_dev" default="/dev/input/js0"/>
    <arg name="joy_topic" default="/legged_robot/joystick" doc="sensor_msgs/Joy 全局话题名"/>
    <arg name="teleop_config" default="$(find legged_controllers)/config/joy.yaml"/>
    <arg name="enable_joy_gait" default="false" doc="true：加载 joy_gait_mappings.yaml（须先 load_controller 以设置 /gaitCommandFile）"/>

    <node pkg="joy" type="joy_node" name="joy_node" output="screen">
        <param name="dev" value="$(arg joy_dev)"/>
        <param name="deadzone" value="1e-3"/>
        <param name="autorepeat_rate" value="10"/>
        <param name="coalesce_interval" value="0.05"/>
        <remap from="joy" to="$(arg joy_topic)"/>
    </node>

    <rosparam file="$(arg teleop_config)" command="load"/>
    <node pkg="joy_teleop" type="joy_teleop.py" name="joy_teleop" output="screen">
        <remap from="joy" to="$(arg joy_topic)"/>
    </node>

    <include file="$(find legged_controllers)/launch/joy_gait_mux.launch">
        <arg name="enable_joy_gait" value="$(arg enable_joy_gait)"/>
        <arg name="joy_topic" value="$(arg joy_topic)"/>
    </include>
</launch>
